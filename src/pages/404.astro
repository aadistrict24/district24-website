---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
---
<BaseLayout title="Page Not Found">
  <div class="page">
    <h1 class="page-h1">Page Not Found</h1>
    <Card>
      <p class="page-p">Sorry, we couldn't find that page.</p>
      <p class="page-p"><a href="/" class="inline-link">Go to the District 24 home page</a></p>
    </Card>
  </div>
</BaseLayout>
